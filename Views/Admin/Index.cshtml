@{
    ViewBag.Title = "Панель администратора";
}

<div class="container mt-5">
    <h1>Панель администратора</h1>
    <hr />

    <div class="row">
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Товары</h5>
                    <p class="card-text">Управление каталогом спортивной одежды.</p>
                    <a asp-action="Products" class="btn btn-primary">Перейти к товарам</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Категории</h5>
                    <p class="card-text">Управление категориями (обувь, футболки и т.д.).</p>
                    <a asp-action="Categories" class="btn btn-primary">Перейти к категориям</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-body">
                    <h5 class="card-title">Заказы</h5>
                    <p class="card-text">Просмотр и обработка заказов.</p>
                    <!-- Ссылка появится, когда сделаем Заказы -->
                    <a href="#" class="btn btn-secondary disabled">В разработке</a>
                </div>
            </div>
        </div>
    </div>
</div>