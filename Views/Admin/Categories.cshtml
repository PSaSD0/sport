@model IEnumerable<sport.Domain.Entities.Category>

@{
    ViewBag.Title = "Список категорий";
}

<div class="container mt-4">
    <h2>Категории</h2>
    <p>
        <a asp-action="CategoryEdit" asp-route-id="0" class="btn btn-success">Добавить категорию</a>
    </p>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Название</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Id</td>
                    <td>@category.Title</td>
                    <td>
                        <a asp-action="CategoryEdit" asp-route-id="@category.Id" class="btn btn-sm btn-primary">Редактировать</a>
                        <form asp-action="CategoryDelete" asp-route-id="@category.Id" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Удалить категорию?');">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>